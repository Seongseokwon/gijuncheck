# 배포 URL 오버라이드
#
# 도메인 연결 **전에** Vercel 임시 URL 로 배포할 때만 지정한다.
# 이 값이 있으면 색인이 자동으로 차단되고 화면에 테스트 배포 배너가 뜬다.
#
#   NEXT_PUBLIC_SITE_URL=https://sabohum-xxxx.vercel.app
#
# 도메인을 연결한 뒤에는 이 변수를 **삭제**해야 색인이 열린다.
# 삭제 후 재배포 → robots.txt 가 allow 로 바뀌고 배너가 사라진다.
#
# 설정 위치: Vercel 대시보드 > Project > Settings > Environment Variables
NEXT_PUBLIC_SITE_URL=


# Google Analytics 4 측정 ID
#
# 값이 없으면 GA 스크립트를 아예 넣지 않는다.
# 로컬 개발이나 임시 배포에서 데이터가 더러워지는 걸 막기 위한 것이니,
# 본 도메인에 붙인 뒤에 설정하는 편이 깨끗하다.
#
#   NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# 수집 항목은 개인정보처리방침(/privacy)에 명시한 범위를 벗어나면 안 된다.
# 소득·재산 금액은 어떤 형태로도 보내지 않는다. src/lib/analytics.ts 참조.
NEXT_PUBLIC_GA_ID=
